<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Optional helper for hiding in chosen apps and while typing. Sideload build only. -->
        <service
            android:name=".service.IslandHelperService"
            android:exported="false"
            android:label="@string/helper_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/island_helper_service" />
        </service>
    </application>
</manifest>
